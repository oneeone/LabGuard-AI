# 演示模式：不调用真实视觉 API，结果为固定样例并显式标记 DEMO（默认可离线运行）。
VISION_MODE=demo

# real 模式必须同时配置以下三项；缺任意一项会在发起请求前报 NOT_CONFIGURED，请求数为 0。
# 接口须兼容 OpenAI 的 /chat/completions 协议（可直接写完整地址，也可只写基础地址）。
VISION_API_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# 可选：连接与读取超时（Spring Duration 格式，如 5s、500ms）。
VISION_CONNECT_TIMEOUT=5s
VISION_READ_TIMEOUT=30s

# 可选：人工核验规则。置信度低于阈值时强制 needsHumanReview=true（默认 0.6）。
VISION_MIN_CONFIDENCE=0.6
# 可选：风险类别白名单（逗号分隔，大写比较），留空不限制；未知类别保留原文并追加人工核验，不会被静默归类。
VISION_CATEGORY_WHITELIST=

# 图片限制：仅 JPG/JPEG/PNG，单张不超过 10MB，超出在发送前拒绝（UNSUPPORTED_IMAGE）。

PORT=8080
