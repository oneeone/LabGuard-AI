# LabGuard AI 环境变量清单。Spring Boot 不自动读取本文件；
# 工程的 EnvConfig（META-INF/spring.factories 注册）会在启动前加载项目根目录的 .env。
# 优先级：操作系统环境变量 > .env > application.properties 默认值。
# 复制为 .env 使用：Copy-Item .env.example .env（.env 已在 .gitignore 中，绝不提交密钥）

# ---------- 运行模式 ----------
# 演示模式：不调用真实视觉 API，结果为固定样例并显式标记 DEMO（默认可离线运行）。
VISION_MODE=demo

# real 模式必须同时配置以下三项；缺任意一项会在发起请求前报 NOT_CONFIGURED，请求数为 0。
# 接口须兼容 OpenAI 的 /chat/completions 协议（可直接写完整地址，也可只写基础地址）。
VISION_API_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# 可选：连接与读取超时（Spring Duration 格式，如 5s、500ms）。
VISION_CONNECT_TIMEOUT=5s
VISION_READ_TIMEOUT=30s

# 可选：人工核验规则。置信度低于阈值时强制 needsHumanReview=true（默认 0.6）。
VISION_MIN_CONFIDENCE=0.6
# 可选：风险类别白名单（逗号分隔，大写比较），留空不限制；未知类别保留原文并追加人工核验，不会被静默归类。
VISION_CATEGORY_WHITELIST=

# ---------- 数据源（默认 SQLite 文件库，冻结技术栈；下列留空即用默认） ----------
# DB_URL=jdbc:sqlite:./data/labguard.db
# DB_DRIVER=org.sqlite.JDBC
# 切换 MySQL 时取消注释并提供账号（需自行添加 mysql 驱动依赖）：
# DB_URL=jdbc:mysql://127.0.0.1:3306/labguard?useSSL=false&serverTimezone=UTC
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# DB_USERNAME=
# DB_PASSWORD=
SQL_INIT_MODE=always

# ---------- Web 与存储 ----------
PORT=8080
UPLOAD_DIR=uploads
# 上传限制：仅 JPG/JPEG/PNG，单张不超过 10MB（与 ImageInput 校验一致，超出在发送前拒绝）。
MAX_FILE_SIZE=10MB
